{
  "manifest_version": 3,
  "name": "Binary Prop Firm - Quotex Trade Sync",
  "version": "1.0.7",
  "description": "Quotex Trade History live sync extension for Binary Prop Firm traders.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://binarypropfirm.com/*",
    "*://*.binarypropfirm.com/*",
    "*://qx.info/*",
    "*://*.qx.info/*",
    "*://market-qx.info/*",
    "*://*.market-qx.info/*",
    "*://market-qx.pro/*",
    "*://*.market-qx.pro/*",
    "*://trade-qx.com/*",
    "*://*.trade-qx.com/*",
    "*://qx-trade.com/*",
    "*://*.qx-trade.com/*",
    "*://market-qx.trade/*",
    "*://*.market-qx.trade/*",
    "*://quotex-broker.com/*",
    "*://*.quotex-broker.com/*",
    "*://qx-market.com/*",
    "*://*.qx-market.com/*",
    "*://qxplus.com/*",
    "*://*.qxplus.com/*",
    "*://quotex-market.com/*",
    "*://*.quotex-market.com/*",
    "*://*.quotex.com/*",
    "*://quotex.com/*",
    "*://*.quotex.io/*",
    "*://quotex.io/*",
    "*://*.qxbroker.com/*",
    "*://qxbroker.com/*",
    "http://localhost:*/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon16.png", "icon48.png", "icon128.png"],
      "matches": ["*://*/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Binary Prop Firm Sync",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://qx.info/*",
        "*://*.qx.info/*",
        "*://market-qx.info/*",
        "*://*.market-qx.info/*",
        "*://market-qx.pro/*",
        "*://*.market-qx.pro/*",
        "*://trade-qx.com/*",
        "*://*.trade-qx.com/*",
        "*://qx-trade.com/*",
        "*://*.qx-trade.com/*",
        "*://market-qx.trade/*",
        "*://*.market-qx.trade/*",
        "*://quotex-broker.com/*",
        "*://*.quotex-broker.com/*",
        "*://qx-market.com/*",
        "*://*.qx-market.com/*",
        "*://qxplus.com/*",
        "*://*.qxplus.com/*",
        "*://quotex-market.com/*",
        "*://*.quotex-market.com/*",
        "*://*.quotex.com/*",
        "*://quotex.com/*",
        "*://*.quotex.io/*",
        "*://quotex.io/*",
        "*://*.qxbroker.com/*",
        "*://qxbroker.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
