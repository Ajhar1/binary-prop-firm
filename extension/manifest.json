{
  "manifest_version": 3,
  "name": "Binary Prop Firm - Quotex Trade Sync",
  "version": "1.0.5",
  "description": "Quotex Trade History live sync extension for Binary Prop Firm traders.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://qx.info/*",
    "*://*.qx.info/*",
    "*://market-qx.info/*",
    "*://*.market-qx.info/*",
    "*://*.quotex.com/*",
    "*://*.quotex.io/*",
    "*://*.qxbroker.com/*",
    "*://*.binarypropfirm.com/*",
    "http://localhost:*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon16.png", "icon48.png", "icon128.png"],
      "matches": ["*://*/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Binary Prop Firm Sync",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://qx.info/*",
        "*://*.qx.info/*",
        "*://market-qx.info/*",
        "*://*.market-qx.info/*",
        "*://*.quotex.com/*",
        "*://*.quotex.io/*",
        "*://*.qxbroker.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
